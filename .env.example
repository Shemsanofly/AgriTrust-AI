# Copy to .env. Never commit real secrets, keys or farmer data.
DEV_MODE=true                  # enables demo endpoints and shows the sandbox OTP; set false in production
DATABASE_URL=sqlite:///./shamba.db
# DATABASE_URL=postgresql+psycopg://shamba:shamba@localhost:5432/shamba
JWT_SECRET=change-me
PUBLIC_WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Blockchain: leave empty to use the local SIMULATED ledger
RPC_URL=
CHAIN_ID=31337
ANCHOR_SIGNER_KEY=             # dev only; never commit a real key
EVIDENCE_REGISTRY_ADDRESS=
RECEIPT_REGISTRY_ADDRESS=

WEATHER_MODE=live              # live (Open-Meteo, falls back offline) | simulated
OPEN_METEO_BASE=https://api.open-meteo.com/v1

AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=        # empty = SMS are only logged
