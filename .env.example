# Copy to .env. Never commit real secrets, keys or farmer data.
DEV_MODE=true                  # enables demo endpoints and shows the sandbox OTP; set false in production
DATABASE_URL=sqlite:///./shamba.db
# DATABASE_URL=postgresql+psycopg://shamba:shamba@localhost:5432/shamba
JWT_SECRET=change-me
PUBLIC_WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Blockchain: leave empty to use the local SIMULATED ledger
RPC_URL=
CHAIN_ID=31337
ANCHOR_SIGNER_KEY=             # dev only; never commit a real key
EVIDENCE_REGISTRY_ADDRESS=
RECEIPT_REGISTRY_ADDRESS=

WEATHER_MODE=live              # live (Open-Meteo, falls back offline) | simulated
OPEN_METEO_BASE=https://api.open-meteo.com/v1

AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=        # empty = SMS are only logged
AFRICASTALKING_USSD_CODE=      # e.g. *384*12345# from the AT dashboard; empty = accept any code
AFRICASTALKING_SENDER_ID=

# USSD / SMS channel (same backend + DB as the web app)
USSD_PROVIDER=africastalking   # africastalking | beem | console
SMS_PROVIDER=africastalking    # africastalking | beem | console
USSD_ENABLED=true
SMS_ENABLED=true
USSD_SESSION_TTL_MINUTES=5
PUBLIC_BASE_URL=               # e.g. https://xxxxx.ngrok-free.app for provider callbacks

BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_USSD_CODE=
BEEM_SENDER_ID=

# Face sign-in (FACEIO, https://console.faceio.net). Empty = hidden.
FACEIO_PUBLIC_ID=
FACEIO_API_KEY=                 # server only; verifies each Facial ID

# Payments: "simulated" (no money moves) or "snippe" (real mobile money, https://snippe.sh)
PAYMENTS_PROVIDER=simulated
SNIPPE_API_KEY=                # Snippe dashboard -> API keys (never commit)
SNIPPE_WEBHOOK_SECRET=         # Snippe dashboard -> Settings -> Webhook Secret
